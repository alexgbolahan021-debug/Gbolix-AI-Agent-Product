NODE_ENV=development
PORT=4100
PUBLIC_BASE_URL=http://localhost:4100
DATABASE_URL=
# Production refuses to start without DATABASE_URL. Set true only for local testing.
ALLOW_MEMORY_STORAGE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI variables are optional when AI_PROVIDER=gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
OPENAI_DEFAULT_MODEL=gpt-5-mini
# DEFAULT_MODEL is kept as a backward-compatible fallback
CREDIT_MODE=local
LOCAL_CREDITS=100000
GBOLIX_PLATFORM_URL=
GBOLIX_PLATFORM_TOKEN=
AGENT_JWT_SECRET=
# Required for encrypting/decrypting native OAuth connection credentials. Keep stable after connections are created.
AGENT_CONNECTION_ENCRYPTION_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
AGENT_ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173,https://gbolix.site
MAX_TOOL_ROUNDS=3
# Native OAuth providers for Level 3 connections
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Required for Google Gmail OAuth authorization and expired access-token refresh.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email automation: one credit per successful campaign email or generated/sent reply.
EMAIL_CAMPAIGN_MAX_ROWS=500
# Set true only after Gmail connections are reauthorized with gmail.readonly + gmail.send.
EMAIL_POLLING_ENABLED=false
EMAIL_POLLING_INTERVAL_MS=300000

# For Gmail reply monitoring, reconnect each agent after the OAuth scope change.
# The frontend supports draft approval or automatic sending per agent.

# Ordered AI fallback. Only providers with configured keys participate.
# Example: try Gemini first, then an OpenAI-compatible provider.
AI_PROVIDER_ORDER=gemini,openai
AI_FALLBACK_ENABLED=true
# AI_PROVIDER remains the backward-compatible first-provider fallback when AI_PROVIDER_ORDER is blank.
